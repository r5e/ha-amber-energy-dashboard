{
  "services": {
    "import_day": {
      "service": "mdi:database-import"
    },
    "run_now": {
      "service": "mdi:play-circle-outline"
    },
    "probe_retention": {
      "service": "mdi:calendar-search"
    },
    "backfill": {
      "service": "mdi:history"
    },
    "migrate_v1": {
      "service": "mdi:database-arrow-right"
    },
    "undo_migration": {
      "service": "mdi:undo"
    },
    "delete_legacy_statistics": {
      "service": "mdi:delete-clock"
    },
    "bill_estimate": {
      "service": "mdi:receipt-text-outline"
    }
  },
  "entity": {
    "button": {
      "run_now": {
        "default": "mdi:play-circle-outline"
      },
      "probe_retention": {
        "default": "mdi:calendar-search"
      }
    },
    "sensor": {
      "status": {
        "default": "mdi:database-sync"
      },
      "last_imported_date": {
        "default": "mdi:calendar-check"
      },
      "days_behind": {
        "default": "mdi:calendar-clock"
      },
      "next_run": {
        "default": "mdi:clock-outline"
      },
      "reconciliation": {
        "default": "mdi:scale-balance"
      },
      "bill_to_date": {
        "default": "mdi:receipt-text-outline"
      },
      "projected_bill": {
        "default": "mdi:receipt-text-clock-outline"
      },
      "days_into_cycle": {
        "default": "mdi:calendar-range"
      },
      "average_cost_per_day": {
        "default": "mdi:cash-clock"
      },
      "allowance_used": {
        "default": "mdi:transmission-tower-export"
      },
      "allowance_remaining": {
        "default": "mdi:battery-arrow-up-outline"
      },
      "export_charge": {
        "default": "mdi:cash-minus"
      }
    }
  }
}
